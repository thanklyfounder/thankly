{
  "expo": {
    "name": "thankly-mobile",
    "slug": "thankly-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/app-icon-true.png",
    "splash": {
      "image": "./assets/splash/thankly-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B3D91"
    },
    "scheme": "thanklymobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thankly.app"
    },
    "android": {
      "package": "com.thankly.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/icons/app-icon-true.png",
        "backgroundImage": "./assets/icons/app-icon-true.png",
        "monochromeImage": "./assets/icons/app-icon-true.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icons/app-icon-true.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash/thankly-splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B3D91",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Thankly to use Face ID to protect your account."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Thankly uses your camera to scan business invite QR codes."
        }
      ],
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
