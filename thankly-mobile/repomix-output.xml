                    style={styles.dateButton}
                    onPress={() => setShowEndPicker(true)}
                  >
                    <Text style={styles.dateLabel}>{t.activity.end}</Text>
                    <Text style={styles.dateValue}>
                      {customEndDate.toLocaleDateString()}
                    </Text>
                  </TouchableOpacity>
